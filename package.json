{
  "name": "rayzee-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "rayzee",
    "app"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm -w @rayzee/app run dev",
    "build": "npm -w rayzee run build && npm -w @rayzee/app run build",
    "build:app": "npm -w @rayzee/app run build",
    "build:engine": "npm -w rayzee run build",
    "lint": "eslint .",
    "lint-fix": "npx eslint --fix",
    "preview": "npm -w @rayzee/app run preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node bench/runner/cli.js run",
    "bench:quality": "node bench/runner/cli.js quality",
    "bench:denoise": "node bench/runner/cli.js denoise",
    "bench:memory": "node bench/runner/cli.js memory",
    "bench:perf": "node bench/runner/cli.js perf",
    "bench:kernels": "node bench/runner/cli.js kernels",
    "bench:bless": "node bench/runner/cli.js bless",
    "bench:ab": "node bench/runner/cli.js ab",
    "bench:list": "node bench/runner/cli.js list",
    "release": "cross-env $(cat .env | xargs) semantic-release --no-ci",
    "bench:lut": "node bench/tools/gen-dfg-lut.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.1",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.9.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0",
    "semantic-release": "^24.2.1",
    "semantic-release-export-data": "^1.2.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}

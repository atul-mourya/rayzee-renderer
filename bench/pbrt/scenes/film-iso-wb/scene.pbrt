LookAt 0 1.2 4  0 0.6 0  0 1 0
Camera "perspective" "float fov" 30
Film "rgb" "integer xresolution" 256 "integer yresolution" 192 "string filename" "out.exr" "float iso" 250 "float whitebalance" 4500
Integrator "path" "integer maxdepth" 32
WorldBegin
LightSource "infinite" "rgb L" [ 1 1 1 ]
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.7 0.35 0.15 ]
  Translate 0 0.6 0
  Shape "sphere" "float radius" 0.6
AttributeEnd
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.7 0.35 0.15 ]
  Shape "trianglemesh" "point3 P" [ -4 0 -4  4 0 -4  4 0 4  -4 0 4 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd

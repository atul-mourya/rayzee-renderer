{
  "name": "rayzee",
  "version": "11.3.0",
  "type": "module",
  "description": "Real-time WebGPU path tracing engine built on Three.js",
  "main": "dist/rayzee.umd.js",
  "module": "dist/rayzee.es.js",
  "exports": {
    ".": {
      "import": "./dist/rayzee.es.js",
      "require": "./dist/rayzee.umd.js"
    },
    "./core": {
      "import": "./dist/rayzee-core.es.js"
    },
    "./addons/physical-sky": {
      "import": "./dist/addons/physical-sky.es.js"
    },
    "./addons/archives": {
      "import": "./dist/addons/archives.es.js"
    },
    "./addons/bidirectional": {
      "import": "./dist/addons/bidirectional.es.js"
    },
    "./addons/color": {
      "import": "./dist/addons/color.es.js"
    },
    "./addons/storage": {
      "import": "./dist/addons/storage.es.js"
    },
    "./addons/formats": {
      "import": "./dist/addons/formats.es.js"
    },
    "./node": "./src/node/index.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atul-mourya/rayzee-renderer.git",
    "directory": "rayzee"
  },
  "keywords": [
    "path-tracing",
    "webgpu",
    "three.js",
    "ray-tracing",
    "renderer"
  ],
  "author": "Atul Mourya",
  "license": "MIT",
  "scripts": {
    "build": "vite build && RAYZEE_FORMAT=umd vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "optionalDependencies": {
    "oidn-web": ">=0.4.0",
    "onnxruntime-web": ">=1.0.0"
  }
}

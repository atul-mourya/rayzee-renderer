#usda 1.0
def Scope "Looks"
{
    def Material "Red"
    {
        token outputs:surface.connect = </Looks/Red/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 0, 0)
            token outputs:surface
        }
    }
    def Material "Green"
    {
        token outputs:surface.connect = </Looks/Green/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 1, 0)
            token outputs:surface
        }
    }
    def Material "Blue"
    {
        token outputs:surface.connect = </Looks/Blue/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 1)
            token outputs:surface
        }
    }
}
def Xform "Inherit" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Red>
    def Mesh "Tri"
    {
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
    }
}
def Xform "Own" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Red>
    def Mesh "Tri" ( prepend apiSchemas = ["MaterialBindingAPI"] )
    {
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Looks/Green>
    }
}
def Xform "FullAbove" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:full = </Looks/Blue>
    def Mesh "Tri" ( prepend apiSchemas = ["MaterialBindingAPI"] )
    {
        point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Looks/Green>
    }
}
def Xform "Stronger" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Blue> (
        bindMaterialAs = "strongerThanDescendants"
    )
    def Mesh "Tri" ( prepend apiSchemas = ["MaterialBindingAPI"] )
    {
        point3f[] points = [(6, 0, 0), (7, 0, 0), (6, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Looks/Red>
    }
}
def Xform "Preview" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:preview = </Looks/Red>
    def Mesh "Tri" ( prepend apiSchemas = ["MaterialBindingAPI"] )
    {
        point3f[] points = [(8, 0, 0), (9, 0, 0), (8, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </Looks/Green>
    }
}
def PointInstancer "PI1" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Red>
    rel prototypes = [</PI1/Prototypes/P>]
    int[] protoIndices = [0]
    point3f[] positions = [(10, 0, 0)]
    def Scope "Prototypes" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/Green>
        def Xform "P"
        {
            def Mesh "Tri"
            {
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
            }
        }
    }
}
def Xform "Outside" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Blue>
    double3 xformOp:translate = (20, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    def Xform "P"
    {
        def Mesh "Tri"
        {
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
        }
    }
}
def PointInstancer "PI3" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Red>
    rel prototypes = [</Outside/P>]
    int[] protoIndices = [0]
    point3f[] positions = [(12, 0, 0)]
}
def PointInstancer "PI4" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Green>
    rel prototypes = [</Outside/P>]
    int[] protoIndices = [0]
    point3f[] positions = [(14, 0, 0)]
}

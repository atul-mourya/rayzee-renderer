<?xml version="1.0"?>
<materialx version="1.39">
  <oren_nayar_diffuse_bsdf name="diffuse" type="BSDF">
    <input name="color" type="color3" value="0.6, 0.1, 0.1" />
    <input name="roughness" type="float" value="0.5" />
  </oren_nayar_diffuse_bsdf>
  <dielectric_bsdf name="coat" type="BSDF">
    <input name="ior" type="float" value="1.5" />
    <input name="roughness" type="vector2" value="0.04, 0.04" />
  </dielectric_bsdf>
  <layer name="stack" type="BSDF">
    <input name="top" type="BSDF" nodename="coat" />
    <input name="base" type="BSDF" nodename="diffuse" />
  </layer>
  <uniform_edf name="glow" type="EDF">
    <input name="color" type="color3" value="0.2, 0.3, 0.1" />
  </uniform_edf>
  <surface name="Lacquer_S" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="stack" />
    <input name="edf" type="EDF" nodename="glow" />
    <input name="opacity" type="float" value="1" />
  </surface>
  <surfacematerial name="Lacquer" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Lacquer_S" />
  </surfacematerial>
  <conductor_bsdf name="metal" type="BSDF">
    <input name="ior" type="color3" value="0.18, 0.42, 1.37" />
    <input name="extinction" type="color3" value="3.42, 2.35, 1.77" />
    <input name="roughness" type="vector2" value="0.2, 0.2" />
  </conductor_bsdf>
  <surface name="Copper_S" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="metal" />
  </surface>
  <surfacematerial name="Copper" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Copper_S" />
  </surfacematerial>
  <UsdPreviewSurface name="Preview_S" type="surfaceshader">
    <input name="diffuseColor" type="color3" value="0.1, 0.5, 0.2" />
    <input name="roughness" type="float" value="0.7" />
    <input name="metallic" type="float" value="0.1" />
    <input name="clearcoat" type="float" value="0.5" />
    <input name="opacity" type="float" value="0.9" />
  </UsdPreviewSurface>
  <surfacematerial name="Preview" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Preview_S" />
  </surfacematerial>
</materialx>

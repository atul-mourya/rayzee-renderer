#usda 1.0

def "MaterialX"
{
    def "Materials"
    {
        def Material "Tiles" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
        )
        {
            string config:mtlx:version = "1.39"
            color3f inputs:base_color
            float inputs:base_diffuse_roughness
            float inputs:base_metalness
            float inputs:base_weight
            color3f inputs:coat_color
            float inputs:coat_darkening
            float inputs:coat_ior = 1.45
            float inputs:coat_roughness = 0.15
            float inputs:coat_roughness_anisotropy
            float inputs:coat_weight = 0.6
            color3f inputs:emission_color = (1, 0.5, 0.25)
            float inputs:emission_luminance = 2
            color3f inputs:fuzz_color = (0.9, 0.8, 0.7)
            float inputs:fuzz_roughness
            float inputs:fuzz_weight = 0.3
            float3 inputs:geometry_coat_normal
            float3 inputs:geometry_coat_tangent
            float3 inputs:geometry_normal
            float inputs:geometry_opacity = 0.8
            float3 inputs:geometry_tangent
            bool inputs:geometry_thin_walled
            color3f inputs:specular_color
            float inputs:specular_ior
            float inputs:specular_roughness
            float inputs:specular_roughness_anisotropy = 0.4
            float inputs:specular_weight
            color3f inputs:subsurface_color
            float inputs:subsurface_radius
            color3f inputs:subsurface_radius_scale
            float inputs:subsurface_scatter_anisotropy
            float inputs:subsurface_weight
            float inputs:thin_film_ior
            float inputs:thin_film_thickness = 0.45
            float inputs:thin_film_weight = 0.5
            color3f inputs:transmission_color
            float inputs:transmission_depth
            float inputs:transmission_dispersion_abbe_number
            float inputs:transmission_dispersion_scale
            color3f inputs:transmission_scatter
            float inputs:transmission_scatter_anisotropy
            float inputs:transmission_weight
            token outputs:mtlx:surface.connect = </MaterialX/Materials/Tiles/Tiles_OP.outputs:surface>

            def Shader "Tiles_OP" (
                prepend references = </MaterialX/Shaders/Tiles_OP>
            )
            {
                color3f inputs:base_color.connect = </MaterialX/Materials/Tiles/NG_Tiles.outputs:color_out>
                float inputs:base_diffuse_roughness.connect = </MaterialX/Materials/Tiles.inputs:base_diffuse_roughness>
                float inputs:base_metalness.connect = </MaterialX/Materials/Tiles/NG_Tiles.outputs:metal_out>
                float inputs:base_weight.connect = </MaterialX/Materials/Tiles.inputs:base_weight>
                color3f inputs:coat_color.connect = </MaterialX/Materials/Tiles.inputs:coat_color>
                float inputs:coat_darkening.connect = </MaterialX/Materials/Tiles.inputs:coat_darkening>
                float inputs:coat_ior.connect = </MaterialX/Materials/Tiles.inputs:coat_ior>
                float inputs:coat_roughness.connect = </MaterialX/Materials/Tiles.inputs:coat_roughness>
                float inputs:coat_roughness_anisotropy.connect = </MaterialX/Materials/Tiles.inputs:coat_roughness_anisotropy>
                float inputs:coat_weight.connect = </MaterialX/Materials/Tiles.inputs:coat_weight>
                color3f inputs:emission_color.connect = </MaterialX/Materials/Tiles.inputs:emission_color>
                float inputs:emission_luminance.connect = </MaterialX/Materials/Tiles.inputs:emission_luminance>
                color3f inputs:fuzz_color.connect = </MaterialX/Materials/Tiles.inputs:fuzz_color>
                float inputs:fuzz_roughness.connect = </MaterialX/Materials/Tiles.inputs:fuzz_roughness>
                float inputs:fuzz_weight.connect = </MaterialX/Materials/Tiles.inputs:fuzz_weight>
                float3 inputs:geometry_coat_normal.connect = </MaterialX/Materials/Tiles.inputs:geometry_coat_normal>
                float3 inputs:geometry_coat_tangent.connect = </MaterialX/Materials/Tiles.inputs:geometry_coat_tangent>
                float3 inputs:geometry_normal.connect = </MaterialX/Materials/Tiles.inputs:geometry_normal>
                float inputs:geometry_opacity.connect = </MaterialX/Materials/Tiles.inputs:geometry_opacity>
                float3 inputs:geometry_tangent.connect = </MaterialX/Materials/Tiles.inputs:geometry_tangent>
                bool inputs:geometry_thin_walled.connect = </MaterialX/Materials/Tiles.inputs:geometry_thin_walled>
                color3f inputs:specular_color.connect = </MaterialX/Materials/Tiles.inputs:specular_color>
                float inputs:specular_ior.connect = </MaterialX/Materials/Tiles.inputs:specular_ior>
                float inputs:specular_roughness.connect = </MaterialX/Materials/Tiles/NG_Tiles.outputs:rough_out>
                float inputs:specular_roughness_anisotropy.connect = </MaterialX/Materials/Tiles.inputs:specular_roughness_anisotropy>
                float inputs:specular_weight.connect = </MaterialX/Materials/Tiles.inputs:specular_weight>
                color3f inputs:subsurface_color.connect = </MaterialX/Materials/Tiles.inputs:subsurface_color>
                float inputs:subsurface_radius.connect = </MaterialX/Materials/Tiles.inputs:subsurface_radius>
                color3f inputs:subsurface_radius_scale.connect = </MaterialX/Materials/Tiles.inputs:subsurface_radius_scale>
                float inputs:subsurface_scatter_anisotropy.connect = </MaterialX/Materials/Tiles.inputs:subsurface_scatter_anisotropy>
                float inputs:subsurface_weight.connect = </MaterialX/Materials/Tiles.inputs:subsurface_weight>
                float inputs:thin_film_ior.connect = </MaterialX/Materials/Tiles.inputs:thin_film_ior>
                float inputs:thin_film_thickness.connect = </MaterialX/Materials/Tiles.inputs:thin_film_thickness>
                float inputs:thin_film_weight.connect = </MaterialX/Materials/Tiles.inputs:thin_film_weight>
                color3f inputs:transmission_color.connect = </MaterialX/Materials/Tiles.inputs:transmission_color>
                float inputs:transmission_depth.connect = </MaterialX/Materials/Tiles.inputs:transmission_depth>
                float inputs:transmission_dispersion_abbe_number.connect = </MaterialX/Materials/Tiles.inputs:transmission_dispersion_abbe_number>
                float inputs:transmission_dispersion_scale.connect = </MaterialX/Materials/Tiles.inputs:transmission_dispersion_scale>
                color3f inputs:transmission_scatter.connect = </MaterialX/Materials/Tiles.inputs:transmission_scatter>
                float inputs:transmission_scatter_anisotropy.connect = </MaterialX/Materials/Tiles.inputs:transmission_scatter_anisotropy>
                float inputs:transmission_weight.connect = </MaterialX/Materials/Tiles.inputs:transmission_weight>
            }

            def "NG_Tiles" (
                prepend references = </MaterialX/NodeGraphs/NG_Tiles>
            )
            {
            }
        }

        def Material "Glass" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
        )
        {
            string config:mtlx:version = "1.39"
            color3f inputs:base_color
            float inputs:base_diffuse_roughness
            float inputs:base_metalness
            float inputs:base_weight
            color3f inputs:coat_color
            float inputs:coat_darkening
            float inputs:coat_ior
            float inputs:coat_roughness
            float inputs:coat_roughness_anisotropy
            float inputs:coat_weight
            color3f inputs:emission_color
            float inputs:emission_luminance
            color3f inputs:fuzz_color
            float inputs:fuzz_roughness
